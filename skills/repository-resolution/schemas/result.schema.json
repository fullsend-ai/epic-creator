{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "Repository resolution result",
  "oneOf": [
    {"$ref": "#/$defs/resolved"},
    {"$ref": "#/$defs/unresolved"}
  ],
  "$defs": {
    "key": {"type": "string", "minLength": 1},
    "phase1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hints"],
          "properties": {
            "hints": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["skipped"],
          "properties": {"skipped": {"enum": ["no-components", "no-mapping"]}}
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "quote"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "namespace", "name", "url", "hint", "evidence"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "namespace": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "hint": {"enum": ["confirmed", "none"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phase1", "repositories", "overridden_hints"],
      "properties": {
        "status": {"const": "resolved"},
        "phase1": {"$ref": "#/$defs/phase1"},
        "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
        "overridden_hints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "reason"],
            "properties": {
              "key": {"$ref": "#/$defs/key"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phase1", "reason", "candidates", "evidence"],
      "properties": {
        "status": {"const": "unresolved"},
        "phase1": {"$ref": "#/$defs/phase1"},
        "reason": {"type": "string", "minLength": 1},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
