{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolver.schema.json",
  "title": "Repository resolution configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "group", "sources", "repository_data", "jira"],
  "properties": {
    "version": {"const": 1},
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "repository_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "host"],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/relativePath"},
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        }
      }
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url_field"],
      "properties": {
        "repository_url_field": {
          "type": "string",
          "pattern": "^customfield_[0-9]+$"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "ref", "paths", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "url": {
          "anyOf": [
            {"const": "self"},
            {
              "type": "string",
              "pattern": "^https://[a-z0-9.-]+(/[A-Za-z0-9._-]+)+$"
            }
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "role": {
          "enum": ["architecture", "mapping", "inventory"]
        }
      }
    }
  }
}
