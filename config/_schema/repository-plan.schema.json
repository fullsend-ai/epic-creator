{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_key",
    "mapping_snapshot_digest",
    "requirements",
    "work_items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "mapping_snapshot_digest": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "requirement",
              "acceptance"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "requirement_refs",
          "acceptance_refs",
          "acceptance_criteria",
          "priority",
          "component",
          "team",
          "delivery_type",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "implementation",
              "investigation"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requirement_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_ref",
                "text"
              ],
              "properties": {
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "team": {
            "type": "string",
            "minLength": 1
          },
          "delivery_type": {
            "enum": [
              "general",
              "docs-authoring",
              "konflux-onboarding",
              "license-validation",
              "repo-onboarding"
            ]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "target_key",
                  "evidence_refs"
                ],
                "properties": {
                  "status": {
                    "const": "resolved"
                  },
                  "target_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source_id",
                        "path",
                        "quote"
                      ],
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason",
                  "candidates"
                ],
                "properties": {
                  "status": {
                    "const": "unresolved"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "candidates": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source_id",
                        "path",
                        "quote"
                      ],
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "branch": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "gated_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "source_quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "explicit_repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "source_quote",
          "work_item_ids"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "work_item_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
