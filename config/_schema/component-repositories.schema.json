{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-repositories.schema.json",
  "title": "Jira component to repository keys mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["components"],
  "properties": {
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
      }
    }
  }
}
