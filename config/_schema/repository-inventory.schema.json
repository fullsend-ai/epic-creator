{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "revision", "repositories"],
  "properties": {
    "version": {"const": 1},
    "revision": {"type": "string", "minLength": 1},
    "repositories": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_key", "provider", "host", "namespace", "repository", "label", "approval_reference"],
      "properties": {
        "inventory_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "provider": {"type": "string", "minLength": 1},
        "host": {"type": "string", "pattern": "^[a-zA-Z0-9.-]+$"},
        "namespace": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+(/[a-zA-Z0-9_.-]+)*$"},
        "repository": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
        "label": {"type": "string", "pattern": "^target-repo-[a-z][a-z0-9-]*$", "maxLength": 120},
        "approval_reference": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }}
  }
}
