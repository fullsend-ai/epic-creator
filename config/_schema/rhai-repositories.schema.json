{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "repository_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "repository_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "inventory",
        "sources"
      ],
      "properties": {
        "mode": {
          "const": "one-implementation-epic-per-repository"
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "path"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "guidance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "path"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "url",
              "ref",
              "role",
              "owner"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "role": {
                "enum": [
                  "authoritative",
                  "supporting"
                ]
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "max_age_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
